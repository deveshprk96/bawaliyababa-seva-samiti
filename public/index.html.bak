<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bawaliya Seva Sansthan - Book Gau Seva</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            overflow-x: hidden;
        }

        /* Hero Section with Slider */
        .hero-section {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .slider-container {
            position: absolute;
            width: 100%;
            height: 100%;
            display: flex;
            animation: slide 20s infinite;
        }

        @keyframes slide {
            0%, 20% { transform: translateX(0); }
            25%, 45% { transform: translateX(-100%); }
            50%, 70% { transform: translateX(-200%); }
            75%, 95% { transform: translateX(-300%); }
            100% { transform: translateX(0); }
        }

        .slide {
            min-width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .slide::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(30, 60, 114, 0.3) 0%, rgba(42, 82, 152, 0.4) 100%);
        }

        /* Header */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 20px 50px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            animation: slideDown 0.8s ease-out;
        }

        @keyframes slideDown {
            from {
                transform: translateY(-100%);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-icon {
            font-size: 3em;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .logo h1 {
            color: #1e3c72;
            font-size: 2em;
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .logo p {
            color: #666;
            font-size: 0.9em;
            margin-top: -5px;
        }

        .header-nav {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .nav-link {
            color: #333;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            position: relative;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: #1e3c72;
            transition: width 0.3s;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        /* Floating Booking Card */
        .booking-card {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            width: 450px;
            max-height: 85vh;
            overflow-y: auto;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            z-index: 9999;
            border: 2px solid rgba(30, 60, 114, 0.2);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .booking-card.active {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
        }

        .booking-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            z-index: 9998;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .booking-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .close-booking {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 35px;
            height: 35px;
            background: #f5576c;
            color: white;
            border: none;
            border-radius: 50%;
            font-size: 1.5em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            z-index: 10;
        }

        .close-booking:hover {
            background: #d64456;
            transform: rotate(90deg);
        }

        /* Floating Book Button */
        .float-book-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            border-radius: 50%;
            font-size: 2em;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(30, 60, 114, 0.4);
            z-index: 1000;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: pulse 2s infinite;
        }

        .float-book-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 12px 35px rgba(30, 60, 114, 0.6);
        }

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 8px 25px rgba(30, 60, 114, 0.4);
            }
            50% {
                box-shadow: 0 8px 35px rgba(30, 60, 114, 0.7), 0 0 0 15px rgba(30, 60, 114, 0.1);
            }
        }

        .btn-text {
            position: absolute;
            bottom: -35px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(30, 60, 114, 0.95);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.75em;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .float-book-btn:hover .btn-text {
            opacity: 1;
        }

        .booking-card::-webkit-scrollbar {
            width: 8px;
        }

        .booking-card::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.05);
            border-radius: 10px;
        }

        .booking-card::-webkit-scrollbar-thumb {
            background: #1e3c72;
            border-radius: 10px;
        }

        .booking-card::-webkit-scrollbar-thumb {
            background: #1e3c72;
            border-radius: 10px;
        }

        .booking-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .booking-title h2 {
            color: #1e3c72;
            font-size: 2em;
            margin-bottom: 5px;
        }

        .booking-title p {
            color: #666;
            font-size: 1em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
            font-size: 0.95em;
        }

        input, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1em;
            transition: all 0.3s ease;
            background: white;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #1e3c72;
            box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1);
            transform: translateY(-2px);
        }

        textarea {
            resize: vertical;
            min-height: 80px;
        }

        .location-info {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: 500;
            font-size: 0.9em;
        }

        .location-info.success {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .location-info.error {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        }

        .btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.1em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(30, 60, 114, 0.4);
        }

        .btn:active {
            transform: translateY(-1px);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .message {
            margin-top: 15px;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            font-weight: 500;
            animation: fadeIn 0.5s;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .message.success {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            color: #155724;
        }

        .message.error {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
            color: #721c24;
        }

        .queue-info {
            background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
            padding: 20px;
            border-radius: 15px;
            margin-top: 15px;
            text-align: center;
            animation: fadeIn 0.5s;
        }

        .queue-info h3 {
            color: #333;
            font-size: 1.3em;
            margin-bottom: 12px;
        }

        .queue-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

        .queue-stat {
            background: white;
            padding: 12px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .queue-stat .label {
            font-size: 0.85em;
            color: #666;
            margin-bottom: 5px;
        }

        .queue-stat .value {
            font-size: 1.8em;
            font-weight: 700;
            color: #1e3c72;
        }

        .whatsapp-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #25D366;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-top: 8px;
        }

        .loader {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Info Section */
        .info-section {
            position: absolute;
            bottom: 100px;
            left: 50px;
            max-width: 700px;
            z-index: 100;
            animation: slideInLeft 1.2s ease-out;
        }

        @keyframes slideInLeft {
            from {
                transform: translateX(-500px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .info-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            margin-bottom: 20px;
        }

        .info-card h2 {
            color: #1e3c72;
            font-size: 2.5em;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .info-card p {
            color: #555;
            font-size: 1.2em;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 25px;
        }

        .feature-item {
            background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
            padding: 20px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s;
        }

        .feature-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .feature-icon {
            font-size: 2.5em;
        }

        .feature-text h4 {
            color: #1e3c72;
            font-size: 1.1em;
            margin-bottom: 5px;
        }

        .feature-text p {
            color: #666;
            font-size: 0.9em;
            margin: 0;
        }

        /* Mobile Responsive */
        @media (max-width: 1200px) {
            .booking-card {
                right: 20px;
                width: 400px;
            }

            .info-section {
                left: 20px;
                max-width: 500px;
            }
        }

        @media (max-width: 968px) {
            .booking-card {
                position: relative;
                top: auto;
                right: auto;
                width: 100%;
                max-width: 500px;
                margin: 20px auto;
                animation: fadeIn 1s;
            }

            .info-section {
                position: relative;
                bottom: auto;
                left: auto;
                max-width: 100%;
                padding: 20px;
                animation: fadeIn 1s;
            }

            .hero-section {
                height: 60vh;
            }

            .header {
                padding: 15px 20px;
            }

            .logo h1 {
                font-size: 1.5em;
            }

            .header-nav {
                display: none;
            }

            .features {
                grid-template-columns: 1fr;
            }
        }

        .admin-link {
            text-align: center;
            margin-top: 15px;
        }

        .admin-link a {
            color: #1e3c72;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .admin-link a:hover {
            color: #2a5298;
            text-decoration: underline;
        }

        /* Content Sections */
        .content-wrapper {
            background: #f5f5f5;
            padding: 80px 50px;
        }

        .section {
            max-width: 1400px;
            margin: 0 auto 80px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            color: #1e3c72;
            font-size: 2.5em;
            margin-bottom: 15px;
        }

        .section-title p {
            color: #666;
            font-size: 1.2em;
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Gallery Section */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .gallery-item {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.4s;
            cursor: pointer;
        }

        .gallery-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

        .gallery-item img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            transition: transform 0.4s;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* Seva Cards */
        .seva-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
        }

        .seva-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.4s;
        }

        .seva-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .seva-card-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .seva-card-content {
            padding: 25px;
        }

        .seva-card-content h3 {
            color: #1e3c72;
            font-size: 1.5em;
            margin-bottom: 15px;
        }

        .seva-card-content p {
            color: #666;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .seva-amount {
            font-size: 1.8em;
            color: #1e3c72;
            font-weight: 700;
            margin: 15px 0;
        }

        .donate-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .donate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(30, 60, 114, 0.4);
        }

        /* Contributors Section */
        .contributors-tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        .tab-btn {
            padding: 12px 40px;
            background: #e8d5c4;
            border: none;
            border-radius: 30px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            color: #333;
        }

        .tab-btn.active {
            background: #1e3c72;
            color: white;
        }

        .contributors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .contributor-card {
            background: #e8d5c4;
            padding: 20px;
            border-radius: 15px;
            display: flex;
            gap: 15px;
            align-items: center;
            transition: all 0.3s;
        }

        .contributor-card:hover {
            transform: translateX(5px);
            background: #d4c1af;
        }

        .contributor-avatar {
            width: 50px;
            height: 50px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5em;
            font-weight: 700;
            color: #1e3c72;
            flex-shrink: 0;
        }

        .contributor-info h4 {
            color: #1e3c72;
            font-size: 1.1em;
            margin-bottom: 5px;
        }

        .contributor-info p {
            color: #666;
            font-size: 0.9em;
        }

        .contributor-info .time {
            color: #999;
            font-size: 0.85em;
        }

        /* Stats Section */
        .stats-section {
            background: linear-gradient(135deg, #2a5298 0%, #1e3c72 100%);
            padding: 60px 50px;
            color: white;
            text-align: center;
        }

        .stats-section h2 {
            font-size: 2.5em;
            margin-bottom: 15px;
        }

        .stats-section > p {
            font-size: 1.2em;
            margin-bottom: 50px;
            opacity: 0.9;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 3.5em;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 1.2em;
            opacity: 0.9;
        }

        /* View More Button */
        .view-more {
            text-align: center;
            margin-top: 40px;
        }

        .view-more-btn {
            padding: 15px 50px;
            background: white;
            border: 2px solid #1e3c72;
            color: #1e3c72;
            border-radius: 30px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .view-more-btn:hover {
            background: #1e3c72;
            color: white;
        }

        @media (max-width: 968px) {
            .content-wrapper {
                padding: 40px 20px;
            }

            .section {
                margin-bottom: 50px;
            }

            .gallery-grid,
            .seva-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .stat-number {
                font-size: 2.5em;
            }
        }
    </style>
</head>
<body>
    <!-- Booking Overlay -->
    <div class="booking-overlay" id="bookingOverlay" onclick="closeBookingForm()"></div>

    <!-- Floating Book Appointment Button -->
    <button class="float-book-btn" onclick="openBookingForm()">
        📅
        <span class="btn-text">Book Seva</span>
    </button>

    <!-- Header -->
    <div class="header">
        <div class="header-content">
            <div class="logo">
                <div class="logo-icon">🐄</div>
                <div>
                    <h1>Bawaliya Seva Sansthan</h1>
                    <p>Serving with devotion and care</p>
                </div>
            </div>
            <nav class="header-nav">
                <a href="#" class="nav-link">Home</a>
                <a href="#services" class="nav-link">Services</a>
                <a href="#gallery" class="nav-link">Gallery</a>
                <a href="#contributors" class="nav-link">Contributors</a>
            </nav>
        </div>
    </div>

    <!-- Hero Section with Image Slider -->
    <div class="hero-section">
        <div class="slider-container">
            <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1560493676-04071c5f467b?w=1920&q=80');"></div>
            <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1585116805642-02d8e02ef96c?w=1920&q=80');"></div>
            <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=1920&q=80');"></div>
            <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1600965962102-9d260a71890d?w=1920&q=80');"></div>
        </div>

        <!-- Info Cards on Left -->
        <div class="info-section">
            <div class="info-card">
                <h2>🙏 Gau Seva - A Sacred Service</h2>
                <p>"Whoever feeds the cow with grass and water every day derives the benefit equivalent to performing Ashwamedha Yajna. There is no doubt about this."</p>
                <p style="font-style: italic; color: #1e3c72; font-size: 0.95em;">- Brihat Parasara Smriti 5:26-27</p>
                
                <div class="features">
                    <div class="feature-item">
                        <div class="feature-icon">🌾</div>
                        <div class="feature-text">
                            <h4>Fresh Fodder</h4>
                            <p>Daily green grass & quality feed</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🏥</div>
                        <div class="feature-text">
                            <h4>Medical Care</h4>
                            <p>Regular health checkups</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🏠</div>
                        <div class="feature-text">
                            <h4>Clean Shelter</h4>
                            <p>Hygienic indoor & outdoor space</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">💧</div>
                        <div class="feature-text">
                            <h4>Fresh Water</h4>
                            <p>24/7 clean water supply</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Booking Card -->
    <div class="booking-card" id="bookingCard">
        <button class="close-booking" onclick="closeBookingForm()">×</button>
        
        <div class="booking-title">
            <h2>📅 Book Gau Poshana Seva</h2>
            <p>Join us in this noble service</p>
        </div>

        <div id="locationStatus" class="location-info">
            <span id="locationText">📍 Checking your location...</span>
        </div>

        <form id="bookingForm">
            <div class="form-group">
                <label for="customerName">👤 Your Name</label>
                <input type="text" id="customerName" name="customerName" required placeholder="Enter your full name">
            </div>

            <div class="form-group">
                <label for="customerPhone">📱 Phone Number</label>
                <input type="tel" id="customerPhone" name="customerPhone" required placeholder="+91 9876543210">
            </div>

            <div class="form-group">
                <label for="customerEmail">📧 Email Address</label>
                <input type="email" id="customerEmail" name="customerEmail" required placeholder="your@email.com">
            </div>

            <div class="form-group">
                <label for="notes">📝 Message (Optional)</label>
                <textarea id="notes" name="notes" placeholder="Any special requirements or prayers?"></textarea>
            </div>

            <button type="submit" class="btn" id="submitBtn">
                Book Seva Appointment
            </button>
        </form>

        <div id="message"></div>
    </div>

    <!-- Content Sections Below Hero -->
    <div class="content-wrapper">
        
        <!-- Gallery Section -->
        <div class="section" id="gallery">
            <div class="section-title">
                <h2>Gallery</h2>
            </div>
            <div class="gallery-grid" id="galleryGrid">
                <!-- Gallery items will be loaded dynamically -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1560493676-04071c5f467b?w=800&q=80" alt="Cow shelter">
                </div>
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1585116805642-02d8e02ef96c?w=800&q=80" alt="Feeding cows">
                </div>
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=800&q=80" alt="Cow care">
                </div>
            </div>
        </div>

        <!-- Gaushala Services Section -->
        <div class="section" id="services">
            <div class="section-title">
                <h2>Gaushala Welfare Services</h2>
                <p>Support our Noble Cause to care for and Benefit Cows—Guardians of our Well-Being. Your Donation ensures Nutritious Meals, Vital Health Care, and a Loving Territory for these Gentle Beings.</p>
            </div>
            <div class="seva-grid" id="sevaGrid">
                <!-- Seva cards will be loaded dynamically -->
            </div>
        </div>

        <!-- Seva Options Section -->
        <div class="section">
            <div class="section-title">
                <h2>GAUSHALA SEVA</h2>
            </div>
            <div class="seva-grid" id="sevaOptionsGrid">
                <!-- More seva options will be loaded -->
            </div>
        </div>

        <!-- Stats Section -->
        <div class="stats-section">
            <h2>A Mission of Love and Healing</h2>
            <p>Providing Care and Hope to Cows & Bulls—Together, We Can Make a Difference!</p>
            <div class="stats-grid" id="statsGrid">
                <!-- Stats will be loaded dynamically -->
            </div>
        </div>

        <!-- Contributors Section -->
        <div class="section" id="contributors">
            <div class="section-title">
                <h2>Respected Contributors</h2>
            </div>
            <div class="contributors-tabs">
                <button class="tab-btn active" onclick="loadContributors('recent')">Recent</button>
                <button class="tab-btn" onclick="loadContributors('generous')">Most Generous</button>
            </div>
            <div class="contributors-grid" id="contributorsGrid">
                <!-- Contributors will be loaded dynamically -->
            </div>
            <div class="view-more">
                <button class="view-more-btn">View More</button>
            </div>
        </div>

    </div>

    <script>
        let userLocation = null;
        let vendorSettings = null;
        let locationVerified = false;

        // Open booking form
        function openBookingForm() {
            document.getElementById('bookingCard').classList.add('active');
            document.getElementById('bookingOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
            
            // Get location when form opens
            if (!userLocation) {
                getUserLocation();
            }
        }

        // Close booking form
        function closeBookingForm() {
            document.getElementById('bookingCard').classList.remove('active');
            document.getElementById('bookingOverlay').classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeBookingForm();
            }
        });

        // Get user's location
        async function getUserLocation() {
            const locationStatus = document.getElementById('locationStatus');
            const locationText = document.getElementById('locationText');

            if (!navigator.geolocation) {
                locationStatus.className = 'location-info error';
                locationText.textContent = 'Geolocation is not supported by your browser';
                return;
            }

            try {
                const position = await new Promise((resolve, reject) => {
                    navigator.geolocation.getCurrentPosition(resolve, reject, {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    });
                });

                userLocation = {
                    latitude: position.coords.latitude,
                    longitude: position.coords.longitude
                };

                // Verify location with server
                await verifyLocation();
            } catch (error) {
                locationStatus.className = 'location-info error';
                locationText.textContent = '⚠️ Please enable location access to book an appointment';
                console.error('Error getting location:', error);
            }
        }

        // Verify location is within allowed radius
        async function verifyLocation() {
            const locationStatus = document.getElementById('locationStatus');
            const locationText = document.getElementById('locationText');

            try {
                const response = await fetch('/api/verify-location', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(userLocation)
                });

                const result = await response.json();

                if (result.allowed) {
                    locationStatus.className = 'location-info success';
                    locationText.textContent = `✅ You're ${result.distance}m away - Good to go!`;
                    locationVerified = true;
                } else {
                    locationStatus.className = 'location-info error';
                    locationText.textContent = `❌ You're ${result.distance}m away (max ${result.radius}m allowed)`;
                    locationVerified = false;
                }
            } catch (error) {
                locationStatus.className = 'location-info error';
                locationText.textContent = '⚠️ Could not verify location';
                console.error('Error verifying location:', error);
            }
        }

        // Handle form submission
        document.getElementById('bookingForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            if (!locationVerified) {
                showMessage('Please enable location and ensure you are within the allowed area', 'error');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loader"></span> Booking...';

            const formData = {
                customerName: document.getElementById('customerName').value,
                customerPhone: document.getElementById('customerPhone').value,
                customerEmail: document.getElementById('customerEmail').value,
                customerLat: userLocation.latitude,
                customerLng: userLocation.longitude,
                notes: document.getElementById('notes').value
            };

            try {
                const response = await fetch('/api/book-appointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (response.ok) {
                    showSuccessWithQueue(result);
                    document.getElementById('bookingForm').reset();
                } else {
                    showMessage('❌ ' + (result.error || 'Booking failed'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error booking appointment. Please try again.', 'error');
                console.error('Error:', error);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Book Appointment';
            }
        });

        function showSuccessWithQueue(result) {
            const messageDiv = document.getElementById('message');
            const peopleAhead = result.peopleAhead || 0;
            
            let whatsappBadge = '';
            if (result.whatsappSent) {
                whatsappBadge = '<div class="whatsapp-badge">✅ WhatsApp confirmation sent!</div>';
            }
            
            messageDiv.innerHTML = `
                <div class="queue-info">
                    <h3>🎉 Booking Confirmed!</h3>
                    <p style="font-size: 1.1em; margin: 10px 0;">
                        Welcome! Your appointment at <strong>${result.businessName || 'our facility'}</strong> has been confirmed.
                    </p>
                    ${whatsappBadge}
                    <div class="queue-stats">
                        <div class="queue-stat">
                            <div class="label">Your Position</div>
                            <div class="value">#${result.queuePosition}</div>
                        </div>
                        <div class="queue-stat">
                            <div class="label">People Ahead</div>
                            <div class="value">${peopleAhead}</div>
                        </div>
                    </div>
                    <p style="margin-top: 15px; color: #666;">
                        ${peopleAhead === 0 
                            ? '🏆 You\'re next in line! We\'ll call you shortly.' 
                            : `⏱️ Please wait, we'll serve you soon!`}
                    </p>
                </div>
            `;
            messageDiv.className = 'message';
        }

        function showMessage(text, type) {
            const messageDiv = document.getElementById('message');
            messageDiv.textContent = text;
            messageDiv.className = `message ${type}`;
            
            if (type === 'success') {
                setTimeout(() => {
                    messageDiv.style.display = 'none';
                }, 5000);
            }
        }

        // Initialize
        getUserLocation();

        // Load dynamic content
        loadSevaServices();
        loadSevaOptions();
        loadStats();
        loadContributors('recent');

        // Load Seva Services
        async function loadSevaServices() {
            const services = [
                {
                    name: 'Nourish Cows',
                    description: 'Fresh green fodder and nutritious feed for healthy cows',
                    image: 'https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=500&q=80',
                    amount: '₹500'
                },
                {
                    name: 'Cow Care',
                    description: 'Daily health checkups and medical attention',
                    image: 'https://images.unsplash.com/photo-1585116805642-02d8e02ef96c?w=500&q=80',
                    amount: '₹750'
                },
                {
                    name: 'Cow Treatment',
                    description: 'Medical treatment and emergency care for sick cows',
                    image: 'https://images.unsplash.com/photo-1560493676-04071c5f467b?w=500&q=80',
                    amount: '₹1,000'
                },
                {
                    name: 'Cow Protection Services',
                    description: 'Safe shelter and protection for abandoned cows',
                    image: 'https://images.unsplash.com/photo-1600965962102-9d260a71890d?w=500&q=80',
                    amount: '₹2,500'
                }
            ];

            const grid = document.getElementById('sevaGrid');
            grid.innerHTML = services.map(service => `
                <div class="seva-card">
                    <img src="${service.image}" alt="${service.name}" class="seva-card-image">
                    <div class="seva-card-content">
                        <h3>${service.name}</h3>
                        <p>${service.description}</p>
                        <div class="seva-amount">${service.amount}</div>
                        <button class="donate-btn">Donate</button>
                    </div>
                </div>
            `).join('');
        }

        // Load Seva Options
        async function loadSevaOptions() {
            const options = [
                { name: 'First Roti for Cow', image: 'https://images.unsplash.com/photo-1516467508483-a7212febe31a?w=500&q=80' },
                { name: 'Adopt Cow for 1 Month', image: 'https://images.unsplash.com/photo-1560493676-04071c5f467b?w=500&q=80' },
                { name: 'Nandi Seva', image: 'https://images.unsplash.com/photo-1585116805642-02d8e02ef96c?w=500&q=80' },
                { name: 'Cow Treatment Seva', image: 'https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=500&q=80' },
                { name: 'Cow Shed Seva', image: 'https://images.unsplash.com/photo-1600965962102-9d260a71890d?w=500&q=80' },
                { name: 'Feed 20 Cows', image: 'https://images.unsplash.com/photo-1516467508483-a7212febe31a?w=500&q=80' },
                { name: 'Adopt Calf for 1 Month', image: 'https://images.unsplash.com/photo-1560493676-04071c5f467b?w=500&q=80' },
                { name: 'Medicines Kit for Cows', image: 'https://images.unsplash.com/photo-1585116805642-02d8e02ef96c?w=500&q=80' },
                { name: 'Green Fodder Seva', image: 'https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=500&q=80' }
            ];

            const grid = document.getElementById('sevaOptionsGrid');
            grid.innerHTML = options.map(option => `
                <div class="seva-card">
                    <img src="${option.image}" alt="${option.name}" class="seva-card-image">
                    <div class="seva-card-content">
                        <h3>${option.name}</h3>
                        <button class="donate-btn">Donate</button>
                    </div>
                </div>
            `).join('');
        }

        // Load Stats from Google Sheets
        async function loadStats() {
            try {
                const response = await fetch('/api/stats');
                const statsData = await response.json();
                
                const stats = Object.entries(statsData).map(([label, value]) => ({
                    number: value,
                    label: label
                }));

                const grid = document.getElementById('statsGrid');
                grid.innerHTML = stats.map(stat => `
                    <div class="stat-item">
                        <div class="stat-number">${stat.number}</div>
                        <div class="stat-label">${stat.label}</div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading stats:', error);
                // Fallback to default
                const stats = [
                    { number: '20,000+', label: 'Serving with Love & Care!' },
                    { number: '1,500+', label: 'Under Treatment: Fighting for Life!' },
                    { number: '13,000+', label: 'Healed & Given a New Chance!' }
                ];
                const grid = document.getElementById('statsGrid');
                grid.innerHTML = stats.map(stat => `
                    <div class="stat-item">
                        <div class="stat-number">${stat.number}</div>
                        <div class="stat-label">${stat.label}</div>
                    </div>
                `).join('');
            }
        }

        // Load Contributors from Google Sheets
        async function loadContributors(type) {
            // Update active tab
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
                if ((type === 'recent' && btn.textContent === 'Recent') ||
                    (type === 'generous' && btn.textContent === 'Most Generous')) {
                    btn.classList.add('active');
                }
            });

            try {
                const response = await fetch('/api/contributors');
                let contributors = await response.json();
                
                // Sort by amount if generous, otherwise keep chronological
                const sortedContributors = type === 'generous' 
                    ? [...contributors].sort((a, b) => b.amount - a.amount)
                    : contributors;

                const grid = document.getElementById('contributorsGrid');
                grid.innerHTML = sortedContributors.map(contributor => {
                    // Calculate relative time from timestamp
                    const timeAgo = calculateTimeAgo(contributor.timestamp);
                    
                    return `
                        <div class="contributor-card">
                            <div class="contributor-avatar">${contributor.name.charAt(0).toUpperCase()}</div>
                            <div class="contributor-info">
                                <h4>${contributor.name}</h4>
                                <p>Donated ₹ ${contributor.amount}</p>
                                <p class="time">${timeAgo}</p>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (error) {
                console.error('Error loading contributors:', error);
            }
        }

        // Calculate time ago from timestamp
        function calculateTimeAgo(timestamp) {
            if (!timestamp) return 'recently';
            
            try {
                const date = new Date(timestamp);
                const now = new Date();
                const diffMs = now - date;
                const diffMins = Math.floor(diffMs / 60000);
                const diffHours = Math.floor(diffMins / 60);
                const diffDays = Math.floor(diffHours / 24);
                
                if (diffMins < 60) {
                    return `${diffMins} minute${diffMins !== 1 ? 's' : ''} ago`;
                } else if (diffHours < 24) {
                    return `${diffHours} hour${diffHours !== 1 ? 's' : ''} ago`;
                } else {
                    return `${diffDays} day${diffDays !== 1 ? 's' : ''} ago`;
                }
            } catch (e) {
                return 'recently';
            }
        }

        // Load Gallery Images from Google Sheets for Hero Slider
        async function loadGalleryImages() {
            try {
                const response = await fetch('/api/gallery');
                const images = await response.json();
                
                if (images && images.length > 0) {
                    const slider = document.querySelector('.slider-container');
                    slider.innerHTML = images.slice(0, 4).map(img => `
                        <div class="slide" style="background-image: url('${img.imageUrl}')"></div>
                    `).join('');
                }
            } catch (error) {
                console.error('Error loading gallery:', error);
            }
        }

        // Initialize page - load dynamic content
        window.addEventListener('DOMContentLoaded', () => {
            loadGalleryImages();
            loadStats();
            loadContributors('recent');
        });
    </script>
</body>
</html>
